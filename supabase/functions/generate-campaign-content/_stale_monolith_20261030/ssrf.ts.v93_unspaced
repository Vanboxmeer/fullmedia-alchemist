// Safe page reader for the campaign "news_url" field (added 2026-10-29).
// Same rules as brand-look: public web addresses only. Every hop of a redirect
// is re-checked, a host that resolves to a private / loopback / link-local /
// cloud-metadata address is refused, only ports 80 and 443 are used, and the
// body is size- and time-capped. Any failure returns null (no detail leaks).
const MAX_REDIRECTS = 3;
const FETCH_TIMEOUT_MS = 8000;
const MAX_BYTES = 600_000;

function ipv4Blocked(ip: string): boolean {
  const p = ip.split('.').map(Number);
  if (p.length !== 4 || p.some((n) => !Number.isInteger(n) || n < 0 || n > 255)) return true;
  const [a, b, c] = p;
  if (a === 0 || a === 127 || a === 10) return true;
  if (a === 172 && b >= 16 && b <= 31) return true;
  if (a === 192 && b === 168) return true;
  if (a === 169 && b === 254) return true;
  if (a === 100 && b >= 64 && b <= 127) return true;
  if (a === 198 && (b === 18 || b === 19)) return true;
  if (a === 192 && b === 0 && (c === 0 || c === 2)) return true;
  if (a >= 224) return true;
  return false;
}
function ipv6Blocked(raw: string): boolean {
  const s = raw.toLowerCase().replace(/^\[|\]$/g, '');
  if (s.includes('.')) return true;
  if (s === '::' || s === '::1' || s.startsWith('::')) return true;
  if (/^fe[89ab]/.test(s)) return true;
  if (/^f[cd]/.test(s)) return true;
  if (s.startsWith('ff')) return true;
  if (s.startsWith('64:ff9b:')) return true;
  if (s.startsWith('2002:')) return true;
  if (s.startsWith('2001:db8:') || s.startsWith('2001:0:')) return true;
  return false;
}
const isIpLiteral = (h: string) => /^\[.*\]$/.test(h) || h.includes(':') || /^\d+(\.\d+){3}$/.test(h);

async function hostIsSafe(hostname: string): Promise<boolean> {
  const lower = hostname.toLowerCase();
  if (isIpLiteral(lower)) return false;
  if (lower === 'localhost' || lower.endsWith('.localhost') || lower.endsWith('.internal') || lower.endsWith('.local') || !lower.includes('.')) return false;
  let addrs: string[] = [];
  try {
    const a = await Deno.resolveDns(lower, 'A').catch(() => [] as string[]);
    const aaaa = await Deno.resolveDns(lower, 'AAAA').catch(() => [] as string[]);
    addrs = [...a, ...aaaa];
  } catch {
    return false;
  }
  if (addrs.length === 0) return false;
  for (const ip of addrs) {
    if (ip.includes(':') ? ipv6Blocked(ip) : ipv4Blocked(ip)) return false;
  }
  return true;
}

export async function safeFetchText(rawUrl: string): Promise<string | null> {
  let url: URL;
  try { url = new URL(rawUrl); } catch { return null; }
  for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
    if (url.protocol !== 'http:' && url.protocol !== 'https:') return null;
    if (url.username || url.password) return null;
    if (url.port && url.port !== '80' && url.port !== '443') return null;
    if (!(await hostIsSafe(url.hostname))) return null;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
    let res: Response;
    try {
      res = await fetch(url.toString(), {
        redirect: 'manual',
        signal: ctrl.signal,
        headers: { 'User-Agent': 'FullmediaAlchemist/1.0 (+https://www.fullmediaalchemist.com)', accept: 'text/html,application/xhtml+xml,application/xml,text/plain' },
      });
    } catch {
      clearTimeout(timer);
      return null;
    }
    if (res.status >= 300 && res.status < 400) {
      clearTimeout(timer);
      try { await res.body?.cancel(); } catch { /* ignore */ }
      const loc = res.headers.get('location');
      if (!loc) return null;
      try { url = new URL(loc, url); } catch { return null; }
      continue;
    }
    if (!res.ok) { clearTimeout(timer); try { await res.body?.cancel(); } catch { /* ignore */ } return null; }
    const ctype = (res.headers.get('content-type') || '').toLowerCase();
    if (ctype && !/text\/|xml|html/.test(ctype)) { clearTimeout(timer); try { await res.body?.cancel(); } catch { /* ignore */ } return null; }
    const reader = res.body?.getReader();
    if (!reader) { clearTimeout(timer); return null; }
    const chunks: Uint8Array[] = [];
    let total = 0;
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        total += value.length;
        if (total > MAX_BYTES) { await reader.cancel(); break; }
        chunks.push(value);
      }
    } catch {
      return null;
    } finally { clearTimeout(timer); }
    const size = Math.min(total, MAX_BYTES);
    const buf = new Uint8Array(size);
    let off = 0;
    for (const c of chunks) { if (off + c.length > size) break; buf.set(c, off); off += c.length; }
    const raw = new TextDecoder('utf-8', { fatal: false }).decode(buf);
    const txt = raw.replace(/<(script|style|noscript|svg)[\s\S]*?<\/\1>/gi, ' ').replace(/<!--[\s\S]*?-->/g, ' ').replace(/<\/(p|div|li|h[1-6]|tr|article|section|br)>/gi, '\n').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#8217;|&rsquo;/g, "'").replace(/&quot;/g, '"').replace(/[ \t]+/g, ' ').replace(/\n\s*\n+/g, '\n').trim();
    return txt.length >= 120 ? txt : null;
  }
  return null;
}
